# Salin berkas ini menjadi .env
# Di dalam Docker Compose, aplikasi memakai host `db` dan port 5432.
# PostgreSQL yang diterbitkan Compose ke mesin ini ada di port 5433.
DATABASE_URL=postgresql://queue:queue@127.0.0.1:5433/queue
# Zona waktu bawaan. Bisa diganti dari Admin → Pengaturan (WIB, WITA, atau WIT); pilihan Admin yang dipakai.
APP_TIMEZONE=Asia/Makassar

# Wajib ada saat seed pertama. Ganti sebelum dipakai di cabang. Akun yang masuk dengan sandi
# bawaan atau lemah (termasuk Password123) diminta mengganti sandinya sebelum bisa bekerja.
SEED_ADMIN_PASSWORD=Password123

# Opsional. Seed tidak membuat akun petugas; tambahkan sendiri dari Admin → Petugas.
# Bila diisi, seed membuat petugas.cs dan petugas.teller dengan sandi ini (dipakai uji end-to-end).
SEED_STAFF_PASSWORD=

# Rahasia sesi Auth.js. Ganti dengan string acak yang panjang.
AUTH_SECRET=replace-with-a-long-random-string

# Opsional. Nama lembaga untuk data awal: nama lembaga, nama cabang, dan teks berjalan.
# Kosong berarti "Bank NTT". Bisa diganti lagi dari Admin → Identitas & tampilan.
SEED_ORG_NAME=

# Opsional. Kiosk dan TV didaftarkan dari Admin → Perangkat, masing-masing dengan tautannya sendiri.
# Dua token ini hanya cadangan: bila diisi, /kiosk?token=... dan /display?token=... tetap diterima.
# Uji end-to-end memakai keduanya. Bila diisi, pakai dua string acak yang berbeda.
KIOSK_TOKEN=
DISPLAY_TOKEN=

# Opsional. Ke mana tiket kiosk dikeluarkan: "printer" (cetak langsung ke printer thermal)
# atau "pdf" (diunduh sebagai PDF, untuk mencoba tanpa printer). Kosong berarti pdf saat
# `npm run dev` dan printer di build produksi. "dev" dan "prod" juga diterima.
TICKET_OUTPUT=

# Opsional. Lokasi installer aplikasi kiosk Windows yang disajikan Admin → Perangkat.
# Kosong berarti berkas di downloads/ hasil `npm run kiosk:build` atau tombol Build installer di Admin.
KIOSK_INSTALLER_PATH=

# Opsional. Cadangan `npm run db:backup`: folder tujuan dan berapa hari cadangan disimpan.
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=30
