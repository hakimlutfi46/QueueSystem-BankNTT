# Salin berkas ini menjadi .env
# Di dalam Docker Compose, aplikasi memakai host `db` dan port 5432.
# PostgreSQL yang diterbitkan Compose ke mesin ini ada di port 5433.
DATABASE_URL=postgresql://queue:queue@127.0.0.1:5433/queue
APP_TIMEZONE=Asia/Makassar

# Wajib ada saat seed pertama. Ganti sebelum dipakai di cabang.
SEED_ADMIN_PASSWORD=change-me
SEED_STAFF_PASSWORD=change-me

# Rahasia sesi Auth.js. Ganti dengan string acak yang panjang.
AUTH_SECRET=replace-with-a-long-random-string
