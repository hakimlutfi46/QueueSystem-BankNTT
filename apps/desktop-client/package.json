{
  "name": "bankntt-desktop-client",
  "productName": "BANK NTT Desktop",
  "version": "1.0.0",
  "description": "Aplikasi Windows BANK NTT Admin, Loket, dan TV untuk sistem antrian (satu kode, tiga installer).",
  "author": "Kiosk Antrian",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:admin": "electron . --dev --role=admin",
    "dev:loket": "electron . --dev --role=loket",
    "dev:tv": "electron . --dev --role=tv",
    "test": "node --test test/",
    "check": "node scripts/check.mjs",
    "mock-server": "node scripts/mock-server.mjs",
    "build": "node scripts/build.mjs --app all"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "toolsets": {
      "nsis": "1.2.1"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  }
}
