<!--
  WinSW 2.x service definition for the Bank NTT queue web server.
  WinSW reads this file from next to BankNTT-Server.exe (%BASE%) every time the service starts,
  so changes here apply on the next restart without reinstalling the service.
  install-server.ps1 switches the service account to NT AUTHORITY\NetworkService after installing.
-->
<service>
  <id>BankNTT-Server</id>
  <name>BankNTT Server</name>
  <description>Server antrian Bank NTT (web, layar TV, kiosk, loket) di port 3000.</description>
  <executable>%BASE%\node.exe</executable>
  <arguments>"%BASE%\tools\launcher.js"</arguments>
  <workingdirectory>%BASE%\tools</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>BankNTT-PostgreSQL</depend>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>20 sec</stoptimeout>
  <logpath>%ProgramData%\BankNTT\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
</service>
