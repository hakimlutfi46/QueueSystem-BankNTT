# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/.next-sim/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma client
/src/generated

# playwright
/playwright-report
/test-results
/blob-report

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kiosk desktop (Electron): dependensi, hasil build, dan installer .exe yang disajikan server
/apps/kiosk-desktop/node_modules/
/apps/kiosk-desktop/dist/
/downloads/

# aplikasi Admin/Loket/TV (Electron): dependensi dan hasil build
/apps/desktop-client/node_modules/
/apps/desktop-client/dist/

# cadangan database (npm run db:backup)
/backups/

# build Next.js untuk bundle server Windows (npm run server:bundle)
/.next-bundle/

# worktree sementara Claude Code
/.claude/worktrees/

# sertifikat penandatanganan lokal app Mac (jangan di-commit)
/apps/desktop-client/.signing/
